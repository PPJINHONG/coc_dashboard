# .env로 복사하고 실제 값은 루트 .env 한 곳에서 관리합니다.
# DB 최초 초기화에 사용하는 기본값입니다.
POSTGRES_DB=coc_dashboard
POSTGRES_USER=coc
POSTGRES_PASSWORD=local-development-password

# Django 서명 키. 아래 값은 로컬 실행용 예시입니다.
DJANGO_SECRET_KEY=local-development-only-change-before-deployment-0123456789

# 실행 이미지 버전입니다. Compose가 Dockerfile에 전달합니다.
# 태그는 사람이 읽는 버전, @sha256은 정확한 이미지 내용을 고정합니다.
# 이미지 업데이트 시 해당 줄의 태그와 digest를 함께 변경하세요.

# Django 실행용 Python (Debian bookworm 기반)
PYTHON_IMAGE=python:3.13.16-slim-bookworm@sha256:a1165e272e578941b84abc79e4ab38a0305cd12803a5c4247979ac7655f4d641

# React 빌드에만 사용하는 Node.js (실행 컨테이너에는 포함되지 않음)
NODE_IMAGE=node:24.21.0-bookworm-slim@sha256:d6aa754f16b3197301076f047b5def2f02ea1dbbc2ca920407d46d7ec7f87b20

# React 빌드 파일 제공용 Nginx
NGINX_IMAGE=nginx:1.30.5-alpine3.24@sha256:0985e772fb9f729e6fa0980da05fca5d9c468e870eed43071545afa9d2e27d94

# 데이터베이스: 실제 데이터는 별도의 Docker 볼륨에 저장됩니다.
POSTGRES_IMAGE=postgres:17.11-bookworm@sha256:3645570cccdfa447589da9f57dd740faa29b30938e861289a5574b6ca6b03826
